:root{--bg:#0f1720;--panel:#17212d;--card:#1f2b39;--text:#eef5f2;--muted:#97a6b5;--green:#2fb344;--red:#dc3545;--line:#2c3a49}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:linear-gradient(180deg,#07110b,#0f1720 280px);color:var(--text)}.topbar{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:24px;position:sticky;top:0;background:rgba(15,23,32,.9);backdrop-filter:blur(8px);z-index:2;border-bottom:1px solid var(--line)}h1,h2{margin:0}h1{font-size:28px}h2{font-size:18px}.topbar p,.hint{color:var(--muted);margin:.35rem 0 0}.actions{display:flex;gap:10px}button{border:0;border-radius:10px;padding:10px 14px;background:var(--green);color:white;font-weight:700}.danger{background:var(--red)}.layout{padding:22px;max-width:1400px;margin:auto}.panel,.card{background:rgba(23,33,45,.95);border:1px solid var(--line);border-radius:16px;box-shadow:0 12px 28px rgba(0,0,0,.22)}.upload{padding:18px;margin-bottom:16px}.dropzone{display:flex;align-items:center;justify-content:center;border:2px dashed #3b5a48;border-radius:16px;min-height:120px;margin-top:14px;cursor:pointer;background:#111b24}.dropzone input{display:none}.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-bottom:16px}.card{padding:18px}.card span{display:block;color:var(--muted);font-size:13px}.card strong{font-size:30px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.grid .panel{padding:18px;min-height:340px}.tablePanel{margin-top:16px;padding:18px;overflow:auto}table{width:100%;border-collapse:collapse}th,td{padding:11px;border-bottom:1px solid var(--line);text-align:left}th{color:var(--muted)}#status{margin-top:10px;color:#b8f5c5}@media(max-width:900px){.topbar{display:block}.actions{margin-top:12px}.kpis,.grid{grid-template-columns:1fr}.card strong{font-size:24px}}
